# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for local development.
# Do NOT commit `.env`. Only this `.env.example` is safe to commit.
# ---------------------------------------------------------------------------

# --- Runtime --------------------------------------------------------------
# Set automatically by Next.js (`next dev` -> development, `next build`/`start` -> production).
# NODE_ENV=development

# App environment label used by the app. One of: dev | uat | staging | prod
APP_ENV=dev

# --- Database (Prisma / PostgreSQL) ---------------------------------------
# Native PostgreSQL connection string. Schema/db here is `arabic`.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgres://postgres:postgres@localhost:5432/arabic"

# --- Auth -----------------------------------------------------------------
# HMAC secret for signing session + OTP JWTs. MUST be >= 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Session cookie lifetime in days (default 7)
SESSION_TTL_DAYS=7

# --- URLs -----------------------------------------------------------------
# Base URL the server uses when generating absolute links (e.g. password-reset emails)
APP_URL="http://localhost:3000"

# Public URLs exposed to the browser bundle. For a single Next.js app both point to itself.
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"

# --- Google Maps (optional) ----------------------------------------------
# Required only by the dashboard's location picker / map viewer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Admin seed user ------------------------------------------------------
# Consumed by `npm run db:seed:user` (prisma/seed-user.ts). Password must be >= 8 chars.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-at-least-8-chars"
ADMIN_NAME="Admin"

# --- SMTP / Email (optional) ---------------------------------------------
# If SMTP_USER and SMTP_PASS are unset, email sending is silently skipped.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="King Salman Global Academy <no-reply@console.local>"
