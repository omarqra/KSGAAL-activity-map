.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage

# OS / IDE
.DS_Store
.vscode
.idea

# Project docs not needed in the image
README.md
docs
CLAUDE.md
llms.txt

# Prisma generated client (regenerated inside the image)
src/generated/prisma

# TS incremental cache
tsconfig.tsbuildinfo

# Deployment / pipeline assets (not runtime code)
.azuredevops
azure-pipelines.yml
k8s
docker-compose.yml

# Keep:
#   prisma/schema.prisma  — needed for `prisma generate` + `prisma migrate deploy`
#   prisma/migrations/    — needed by migration Job
#   public/               — static assets served by Next
