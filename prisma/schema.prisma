generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Country {
  id         String     @id @default(cuid())
  code       String     @unique
  name       String
  nameEn     String?
  short      String?
  capital    String?
  lat        Float
  lng        Float
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Organization {
  id         String     @id @default(cuid())
  code       String     @unique
  name       String
  nameEn     String?
  short      String?
  city       String?
  country    String?
  lat        Float
  lng        Float
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Activity {
  id             String        @id @default(cuid())
  name           String
  nameEn         String?
  type           String
  subtype        String?
  date           String?
  published      Boolean       @default(true)
  country        Country?      @relation(fields: [countryId], references: [id])
  countryId      String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
